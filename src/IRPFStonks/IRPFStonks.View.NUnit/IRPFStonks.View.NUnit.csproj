<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.3.0" />
    <PackageReference Include="NUnit.Analyzers" Version="3.5.0" />
    <PackageReference Include="coverlet.collector" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="NUnitFiles\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\NUnitFiles\movimentacao.xlsx" Link="NUnitFiles\movimentacao.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_InvalidDate.xlsx" Link="NUnitFiles\movimentacao_InvalidDate.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_InvalidMovementDirection.xlsx" Link="NUnitFiles\movimentacao_InvalidMovementDirection.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_InvalidMovementType.xlsx" Link="NUnitFiles\movimentacao_InvalidMovementType.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_InvalidTotalPrice.xlsx" Link="NUnitFiles\movimentacao_InvalidTotalPrice.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_InvalidUnitPrice.xlsx" Link="NUnitFiles\movimentacao_InvalidUnitPrice.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_NoHeader.xlsx" Link="NUnitFiles\movimentacao_NoHeader.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\NUnitFiles\movimentacao_WrongHeader.xlsx" Link="NUnitFiles\movimentacao_WrongHeader.xlsx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IRPFStonks.View\IRPFStonks.View.csproj" />
  </ItemGroup>

</Project>
